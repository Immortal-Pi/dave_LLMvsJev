@@ -0,0 +1,340 @@
+/*
+ * Headless stepping bridge for research harnesses.
+ *
+ * Reads one command per line on stdin and answers with one JSON line on stdout:
+ *   reset <level>        start a fresh game (4 lives, score 0) at <level>, release Dave
+ *   step <keys> <ticks>  hold <keys> for up to <ticks> game ticks; keys is "-" or any of
+ *                        L R J D F P (left right jump down fire jetpack-press). P is a
+ *                        key-down event in the original, so it is applied on the first tick only.
+ *   observe              dump the current state
+ *   screenshot <path>    save the last rendered 320x200 frame as BMP (human debugging only)
+ *   quit
+ *
+ * Options: -window opens a 960x600 window showing every tick (human viewing only; it
+ * never changes game logic), -delay <ms> pauses after each shown tick (default 14).
+ *
+ * A step stops early on death, game over, or level exit. After a death the bridge
+ * replays the game's own respawn path (LEVEL_START -> blinking) and releases Dave
+ * with a neutral key press, reporting the extra ticks in "auto_ticks".
+ *
+ * Runs without a window: rendering goes to an in-memory buffer and audio uses SDL's
+ * dummy driver. Must be started with the deadly-dave repository root as working dir.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SDL_MAIN_HANDLED
+#include <SDL.h>
+
+#include "game.h"
+#include "soundfx.h"
+
+/* Globals and routines defined in game.c */
+extern uint32_t *g_pixels;
+extern soundfx_t *g_soundfx;
+int load_assets(void);
+void init_game(game_context_t *game);
+void clear_map(tile_t *map);
+void clear_monsters(game_context_t *game);
+int game_level_load(game_context_t *game, tile_t *map, char *file);
+void game_set_scroll_to_dave(game_context_t *game, dave_t *dave);
+int game_level_blinking(game_context_t *game, tile_t *map, keys_state_t *keys);
+int game_level(game_context_t *game, tile_t *map, keys_state_t *keys);
+int dave_on_ground(dave_t *dave, tile_t map[TILEMAP_WIDTH * TILEMAP_HEIGHT]);
+
+#define BRIDGE_PROTOCOL 1
+#define MAX_RELEASE_TICKS 200
+
+static game_context_t *g_game = NULL;
+static tile_t g_map[TILEMAP_WIDTH * TILEMAP_HEIGHT];
+static int g_state = G_STATE_NONE;
+static long g_ticks = 0;
+static int g_last_scrolling = 0;
+static const char *g_terminal = "running";
+
+/* Optional viewer window (display only). */
+static SDL_Window *g_view_window = NULL;
+static SDL_Renderer *g_view_renderer = NULL;
+static SDL_Texture *g_view_texture = NULL;
+static int g_view_delay_ms = 14;
+
+static void close_view(void) {
+    if (g_view_texture) SDL_DestroyTexture(g_view_texture);
+    if (g_view_renderer) SDL_DestroyRenderer(g_view_renderer);
+    if (g_view_window) SDL_DestroyWindow(g_view_window);
+    g_view_texture = NULL;
+    g_view_renderer = NULL;
+    g_view_window = NULL;
+}
+
+static int open_view(void) {
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO) != 0) return -1;
+    g_view_window = SDL_CreateWindow("deadly-dave (bridge)", SDL_WINDOWPOS_CENTERED,
+                                     SDL_WINDOWPOS_CENTERED, 960, 600, 0);
+    if (g_view_window == NULL) return -1;
+    g_view_renderer = SDL_CreateRenderer(g_view_window, -1, SDL_RENDERER_SOFTWARE);
+    if (g_view_renderer == NULL) return -1;
+    g_view_texture = SDL_CreateTexture(g_view_renderer, SDL_PIXELFORMAT_RGBA8888,
+                                       SDL_TEXTUREACCESS_STREAMING, 320, 200);
+    if (g_view_texture == NULL) return -1;
+    SDL_RenderSetScale(g_view_renderer, 3, 3);
+    return 0;
+}
+
+/* Show the last rendered tick. Closing the window just drops back to headless. */
+static void present_frame(void) {
+    SDL_Event event;
+    if (g_view_window == NULL) return;
+    while (SDL_PollEvent(&event)) {
+        if (event.type == SDL_QUIT ||
+            (event.type == SDL_WINDOWEVENT && event.window.event == SDL_WINDOWEVENT_CLOSE)) {
+            close_view();
+            return;
+        }
+    }
+    SDL_UpdateTexture(g_view_texture, NULL, g_pixels, 320 * sizeof(uint32_t));
+    SDL_RenderClear(g_view_renderer);
+    SDL_RenderCopy(g_view_renderer, g_view_texture, NULL, NULL);
+    SDL_RenderPresent(g_view_renderer);
+    if (g_view_delay_ms > 0) SDL_Delay(g_view_delay_ms);
+}
+
+static void clear_keys(keys_state_t *k) { memset(k, 0, sizeof(*k)); }
+
+static void free_game(void) {
+    if (g_game == NULL) return;
+    clear_monsters(g_game);
+    dave_destroy(g_game->dave);
+    bullet_destroy(g_game->bullet);
+    free(g_game);
+    g_game = NULL;
+}
+
+static int load_level(void) {
+    char path[256];
+    clear_map(g_map);
+    clear_monsters(g_game);
+    if (g_game->dave != NULL) {
+        dave_destroy(g_game->dave);
+        g_game->dave = NULL;
+    }
+    snprintf(path, sizeof(path), "res/levels/level%ld.ddt", (long)g_game->level);
+    if (game_level_load(g_game, g_map, path) != 0 || g_game->dave == NULL) {
+        return -1;
+    }
+    g_game->dave->mute = 1;
+    return 0;
+}
+
+/* Mirror of gameloop's G_STATE_LEVEL_START handling. */
+static void level_start(void) {
+    g_game->dave->tile->x = g_game->dave->default_x;
+    g_game->dave->tile->y = g_game->dave->default_y;
+    g_game->scroll_offset = 0;
+    g_game->blinking_timer = 0;
+    game_set_scroll_to_dave(g_game, g_game->dave);
+    g_state = G_STATE_LEVEL_BLINKING;
+}
+
+/* Run blinking ticks with no keys until releasable, then press a neutral key (space). */
+static int release_dave(void) {
+    keys_state_t keys;
+    int ticks = 0;
+    clear_keys(&keys);
+    while (g_state == G_STATE_LEVEL_BLINKING && ticks < MAX_RELEASE_TICKS) {
+        keys.space = (g_game->blinking_timer >= 10) ? 1 : 0;
+        g_state = game_level_blinking(g_game, g_map, &keys);
+        g_ticks++;
+        present_frame();
+        ticks++;
+    }
+    return ticks;
+}
+
+static void print_json_state(const char *status, int frames, int auto_ticks, const char *error) {
+    dave_t *d = g_game ? g_game->dave : NULL;
+    printf("{\"protocol\":%d,\"status\":\"%s\"", BRIDGE_PROTOCOL, status);
+    if (error) {
+        printf(",\"error\":\"%s\"}\n", error);
+        fflush(stdout);
+        return;
+    }
+    printf(",\"frames\":%d,\"auto_ticks\":%d,\"tick\":%ld,\"game_state\":%d,\"terminal\":\"%s\"",
+           frames, auto_ticks, g_ticks, g_state, g_terminal);
+    if (g_game == NULL || d == NULL) {
+        printf("}\n");
+        fflush(stdout);
+        return;
+    }
+    printf(",\"level\":%ld,\"lives\":%ld,\"score\":%ld,\"scroll_offset\":%ld,\"scrolling\":%d",
+           (long)g_game->level, (long)g_game->lives, (long)g_game->score,
+           (long)g_game->scroll_offset, g_last_scrolling);
+    printf(",\"dave\":{\"x\":%d,\"y\":%d,\"w\":%d,\"h\":%d,\"state\":%d,\"face\":%d,"
+           "\"has_trophy\":%d,\"has_gun\":%d,\"jetpack_bars\":%d,\"on_fire\":%d,\"on_tree\":%d,"
+           "\"jump_state\":%d,\"grounded\":%d}",
+           d->tile->x, d->tile->y, d->tile->width, d->tile->height, d->state, d->face_direction,
+           d->has_trophy, d->has_gun, d->jetpack_bars, d->on_fire, d->on_tree, d->jump_state,
+           dave_on_ground(d, g_map));
+    printf(",\"monsters\":[");
+    int first = 1;
+    for (int i = 0; i < MAX_MONSTERS; i++) {
+        monster_t *m = g_game->monsters[i];
+        if (m == NULL) continue;
+        printf("%s{\"idx\":%d,\"sprite\":%d,\"x\":%d,\"y\":%d,\"w\":%d,\"h\":%d,\"state\":%d,\"alive\":%d",
+               first ? "" : ",", i, m->tile->sprites[0], m->tile->x, m->tile->y, m->tile->width,
+               m->tile->height, m->state, m->is_alive(m));
+        if (m->plasma != NULL) {
+            printf(",\"plasma\":{\"x\":%d,\"y\":%d}", m->plasma->tile->x, m->plasma->tile->y);
+        }
+        printf("}");
+        first = 0;
+    }
+    printf("]");
+    if (g_game->bullet != NULL) {
+        printf(",\"bullet\":{\"x\":%d,\"y\":%d}", g_game->bullet->tile->x, g_game->bullet->tile->y);
+    } else {
+        printf(",\"bullet\":null");
+    }
+    /* Tile modifiers, column-major (index = col*12 + row), one base-36 digit each; drawn tiles only. */
+    printf(",\"map_cols\":%d,\"map_rows\":%d,\"mods\":\"", TILEMAP_WIDTH, TILEMAP_HEIGHT);
+    for (int i = 0; i < TILEMAP_WIDTH * TILEMAP_HEIGHT; i++) {
+        int mod = (g_map[i].sprites[0] != 0) ? g_map[i].mod : 0;
+        putchar("0123456789abcdefghijklmnopqrstuvwxyz"[mod % 36]);
+    }
+    printf("\"}\n");
+    fflush(stdout);
+}
+
+static void cmd_reset(int level) {
+    free_game();
+    /* calloc: init_game leaves some fields unset, and zeroing keeps runs deterministic. */
+    g_game = calloc(1, sizeof(game_context_t));
+    init_game(g_game);
+    g_game->dave = NULL;
+    g_game->level = level;
+    g_ticks = 0;
+    g_terminal = "running";
+    g_last_scrolling = 0;
+    if (load_level() != 0) {
+        free_game();
+        print_json_state("error", 0, 0, "level file failed to load");
+        return;
+    }
+    level_start();
+    int auto_ticks = release_dave();
+    print_json_state("ok", 0, auto_ticks, NULL);
+}
+
+static void cmd_step(const char *keystr, int ticks) {
+    keys_state_t keys;
+    int frames = 0, auto_ticks = 0;
+
+    if (g_game == NULL) {
+        print_json_state("error", 0, 0, "reset first");
+        return;
+    }
+    if (strcmp(g_terminal, "running") != 0) {
+        print_json_state("error", 0, 0, "episode is terminal; reset first");
+        return;
+    }
+    for (int t = 0; t < ticks; t++) {
+        clear_keys(&keys);
+        if (strcmp(keystr, "-") != 0) {
+            keys.left = strchr(keystr, 'L') != NULL;
+            keys.right = strchr(keystr, 'R') != NULL;
+            keys.jump = strchr(keystr, 'J') != NULL;
+            keys.down = strchr(keystr, 'D') != NULL;
+            keys.fire = strchr(keystr, 'F') != NULL;
+            keys.jetpack = (t == 0) && strchr(keystr, 'P') != NULL;
+        }
+        long scroll_before = g_game->scroll_offset;
+        long remaining_before = g_game->scroll_remaining;
+        g_state = game_level(g_game, g_map, &keys);
+        g_ticks++;
+        present_frame();
+        frames++;
+        g_last_scrolling = (scroll_before != g_game->scroll_offset) || (remaining_before != 0);
+
+        if (g_state == G_STATE_LEVEL_START) {
+            /* Death: lives already decremented by game_level. Respawn like gameloop does. */
+            level_start();
+            auto_ticks = release_dave();
+            break;
+        } else if (g_state == G_STATE_GAMEOVER) {
+            g_terminal = "game_over";
+            break;
+        } else if (g_state == G_STATE_WARP_START) {
+            g_terminal = (g_game->in_warp == WARP_RIGHT) ? "level_complete" : "secret_exit";
+            break;
+        } else if (g_state != G_STATE_LEVEL) {
+            g_terminal = "unsupported_state";
+            break;
+        }
+    }
+    print_json_state("ok", frames, auto_ticks, NULL);
+}
+
+static void cmd_screenshot(const char *path) {
+    SDL_Surface *s = SDL_CreateRGBSurfaceWithFormatFrom(g_pixels, 320, 200, 32, 320 * 4,
+                                                        SDL_PIXELFORMAT_RGBA8888);
+    int rc = (s != NULL) ? SDL_SaveBMP(s, path) : -1;
+    if (s) SDL_FreeSurface(s);
+    print_json_state(rc == 0 ? "ok" : "error", 0, 0, rc == 0 ? NULL : "screenshot failed");
+}
+
+int main(int argc, char **argv) {
+    char line[1024];
+    int watch = 0;
+
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "-window") == 0) {
+            watch = 1;
+        } else if (strcmp(argv[i], "-delay") == 0 && i + 1 < argc) {
+            g_view_delay_ms = atoi(argv[++i]);
+        }
+    }
+
+    SDL_SetMainReady();
+    SDL_setenv("SDL_AUDIODRIVER", "dummy", 1);
+    if (SDL_Init(SDL_INIT_AUDIO) != 0) {
+        printf("{\"protocol\":%d,\"status\":\"error\",\"error\":\"SDL audio init failed\"}\n", BRIDGE_PROTOCOL);
+        return 1;
+    }
+    g_pixels = calloc(320 * 200, sizeof(uint32_t));
+    load_assets();
+    g_soundfx = soundfx_create();
+    if (watch && open_view() != 0) {
+        fprintf(stderr, "viewer window unavailable: %s\n", SDL_GetError());
+        close_view();
+    }
+
+    printf("{\"protocol\":%d,\"status\":\"ready\"}\n", BRIDGE_PROTOCOL);
+    fflush(stdout);
+
+    while (fgets(line, sizeof(line), stdin) != NULL) {
+        char cmd[32] = {0}, arg1[512] = {0};
+        int n = 0;
+        int fields = sscanf(line, "%31s %511s %d", cmd, arg1, &n);
+        if (fields < 1) continue;
+
+        if (strcmp(cmd, "reset") == 0 && fields >= 2) {
+            cmd_reset(atoi(arg1));
+        } else if (strcmp(cmd, "step") == 0 && fields == 3 && n > 0) {
+            cmd_step(arg1, n);
+        } else if (strcmp(cmd, "observe") == 0) {
+            print_json_state("ok", 0, 0, NULL);
+        } else if (strcmp(cmd, "screenshot") == 0 && fields >= 2) {
+            cmd_screenshot(arg1);
+        } else if (strcmp(cmd, "quit") == 0) {
+            break;
+        } else {
+            print_json_state("error", 0, 0, "unknown or malformed command");
+        }
+    }
+    free_game();
+    close_view();
+    soundfx_destroy(g_soundfx);
+    SDL_Quit();
+    return 0;
+}
